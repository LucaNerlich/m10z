### APP (http://localhost:3000)
NEXT_PUBLIC_DOMAIN=https://m10z.de
# Months a category stays under "Aktiv" on /kategorien after its most recent
# article/podcast publication; older ones move to "Archiv". Default: 6.
# CATEGORY_ACTIVE_MONTHS=6
NOINDEX_HOSTS=localhost,127.0.0.1,next.m10z.de
STRAPI_INVALIDATION_SECRET=
DIAGNOSTICS_TOKEN=
NODE_ENV=production
#NODE_DEBUG=next:*
NODE_DEBUG=

## TRACKING
NEXT_PUBLIC_UMAMI_WEBSITE_ID=d50684e5-563c-416c-a439-8e9234e5b756
# Optional overrides for Umami session replay (enabled by default)
# NEXT_PUBLIC_UMAMI_URL=https://umami.m10z.de
# NEXT_PUBLIC_UMAMI_SAMPLE_RATE=0.25        # 0.0–1.0
# NEXT_PUBLIC_UMAMI_MASK_LEVEL=moderate     # none | moderate | strict
# NEXT_PUBLIC_UMAMI_MAX_DURATION=300000     # ms per session
# Route podcast audio through an on-domain endpoint that records a server-side Umami
# "podcast-download" event, then 302-redirects to the audio file (reuses the website ID above).
# Applies to both the RSS <enclosure> URLs and the on-site audio player on podcast detail pages.
# Tracking URLs carry a fake ".mp3" suffix (e.g. /api/podcast-download/some-slug.mp3) so podcatchers
# and Apple Podcasts, which sniff the <enclosure> URL for a recognizable audio-file extension, treat
# it as a valid audio file; the route strips the suffix again before slug validation/lookup.
# Podcast apps may keep older direct enclosure URLs for already-seen episodes until they refresh or
# ingest a new episode, so enabling this flag is not retroactive for cached feed entries.
# Set to "true" to enable; leave unset/false to use direct Strapi URLs (default).
FEED_AUDIO_TRACKING_ENABLED=false
# Optional extra HTTPS hosts (comma-separated) the download endpoint may redirect to, e.g. a media
# CDN. The configured STRAPI_URL origin is always allowed; this is only needed for other hosts.
# PODCAST_DOWNLOAD_ALLOWED_HOSTS=
NEXT_TELEMETRY_DISABLED=1

### CMS (http://localhost:1337)
# Server-only Strapi URL (not exposed to client JS). Preferred for all server-side fetches.
STRAPI_URL=https://cms.m10z.de
# Public Strapi URL (bundled into client JS). Only needed for client-side image URL resolution.
# Falls back to STRAPI_URL on the server if not set separately.
NEXT_PUBLIC_STRAPI_URL=https://cms.m10z.de
STRAPI_API_TOKEN=

# Shared secret for preview authentication (must match backend STRAPI_PREVIEW_SECRET)
STRAPI_PREVIEW_SECRET=
