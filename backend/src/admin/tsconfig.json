{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "useDefineForClassFields": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "jsx": "react-jsx",
        // pnpm keeps Strapi's admin packages nested in the virtual store, so
        // the bundler-resolved bare import below needs an explicit type location.
        // Typecheck-only: vite/esbuild ignore `paths`, the admin build still
        // resolves it from Strapi's own dependency tree (explicit vite alias).
        // The store hash is keyed by the whole peer graph, not just the
        // @strapi/design-system version: a lockfile refresh (e.g. a transitive
        // @babel/runtime bump) changes it. A stale path fails loudly with TS2307.
        "baseUrl": ".",
        "paths": {
            "@strapi/design-system": [
                "../../node_modules/.pnpm/@strapi+design-system@2.2.4_@babel+runtime@7.29.10_@codemirror+autocomplete@6.20.0_@cod_eca388d792315e16f1ac2a7467af4c07/node_modules/@strapi/design-system"
            ]
        }
    },
    "include": [
        "../plugins/**/admin/src/**/*",
        "./"
    ],
    "exclude": [
        "node_modules/",
        "build/",
        "dist/",
        "**/*.test.ts"
    ]
}
