# Copy to `load-test/.env` (git-ignored) and set your target.
# `load-test/.env.local` is read too, for local overrides.

# REQUIRED: origin (no trailing slash)
TARGET_ORIGIN=https://your-domain.tld

# Optional: allow http:// targets (NOT recommended for prod)
ALLOW_HTTP=false

# Optional knobs used by ramp/spike scripts
VUS=10
RAMP_UP=1m
STEADY=2m
RAMP_DOWN=30s

HOLD=30s

# Optional: smoke duration override
# DURATION=30s
